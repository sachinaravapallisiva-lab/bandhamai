# Copy to .env.local for local work. Never commit real secrets.
# Sai: set the same names in Vercel → Project → Settings → Environment Variables
# for Production, Preview, and Development.

# Existing
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
XAI_API_KEY=

# Dodo Payments — Bandham AI subscribe ($9.99/mo) and VerifyAI ($4.99 one-time).
# Fail closed if API key or the matching product id is missing.
# Test product IDs (already created). Live ids differ. Sai sets keys on Vercel.
# DODO_PAYMENTS_ENVIRONMENT=test_mode for Test; live_mode for Live.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_SUBSCRIBE_PRODUCT_ID=
DODO_VERIFYAI_PRODUCT_ID=
# DODO_PAYMENTS_ENVIRONMENT=test_mode

# Stripe stays for meetup event tickets only. Not required for Subscribe or VerifyAI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# Optional later. Messaging checkout does not use this.
# STRIPE_FOUNDING_PRICE_ID=

# Meetup event ticket. Separate one-time Stripe Price. Not the Dodo subscribe
# or VerifyAI products. Checkout fails closed if this is empty.
# Do not invent a Price ID or a dollar amount in the app. Sai sets the live Price.
STRIPE_EVENT_PRICE_ID=

# Priority pin is $4.99 for 7 days in the UI. Checkout stays fail closed.
# Do not invent a Stripe Price ID. Do not invent STRIPE_PIN_PRICE_ID.

# Optional VerifyAI third-party handoff. If both START_URL and API_URL+KEY are
# empty, Bandham runs a first-party device check on this origin.
VERIFYAI_START_URL=
VERIFYAI_API_URL=
VERIFYAI_API_KEY=
VERIFYAI_WEBHOOK_SECRET=

# Optional. Used for Checkout success/cancel URLs if Origin is missing.
# NEXT_PUBLIC_SITE_URL=https://bandhamai.vercel.app

# Support tickets (Bandham assistant). Ticket rows still save if email fails.
RESEND_API_KEY=
SUPPORT_INBOX_EMAIL=sachin.aravapallisiva@gmail.com
# Optional for founder ticket mail. Defaults to Resend's onboarding sender until a Bandham domain is verified.
# Welcome on register needs RESEND_API_KEY plus RESEND_FROM_EMAIL on a verified Bandham domain.
# Until then welcome is skipped. Do not invent a domain. Do not use the onboarding sender for welcome.
# RESEND_FROM_EMAIL=

# Phone voice support (xAI Grok Voice Agent). Fail closed if unset.
# Stub only. Set the live value in Vercel. Do not commit a real secret.
BANDHAM_VOICE_SUPPORT_SECRET=

# PostHog visitor funnel. Fail closed if the public key is empty.
# Sai pastes NEXT_PUBLIC_POSTHOG_KEY and NEXT_PUBLIC_POSTHOG_HOST on
# Vercel Production. Do not commit a live .env.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Server only. Comma emails for /admin and /admin/metrics.
# Combined with the founder inbox already in this repo. Empty plus no founder
# admin email fails closed. Never put a personal phone here.
# BANDHAM_ADMIN_EMAILS=
